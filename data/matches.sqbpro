al_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 2*">CREATE TRIGGER trg_check_gods_match_starting_pos
BEFORE INSERT OR UPDATE ON TB_MATCHES
FOR EACH ROW
BEGIN
  SELECT
    CASE
      -- compute what the G‑side god *should* be, given the 2nd‑to‑last char
      WHEN NEW.God_G != (
        CASE substr(NEW.Starting_pos, length(NEW.Starting_pos) - 2, 1)
          WHEN '0' THEN 'APOLLO'
          WHEN '1' THEN 'ARTEMIS'
          WHEN '2' THEN 'ATHENA'
          WHEN '3' THEN 'ATLAS'
          WHEN '4' THEN 'DEMETER'
          WHEN '5' THEN 'HEPHAESTUS'
          WHEN '6' THEN 'HERMES'
          WHEN '7' THEN 'MINOTAUR'
          WHEN '8' THEN 'PAN'
          WHEN '9' THEN 'PROMETHEUS'
        END
      )
      -- or the B‑side god *should* be, given the last char
      OR NEW.God_B != (
        CASE substr(NEW.Starting_pos, length(NEW.Starting_pos) - 1, 1)
          WHEN '0' THEN 'APOLLO'
          WHEN '1' THEN 'ARTEMIS'
          WHEN '2' THEN 'ATHENA'
          WHEN '3' THEN 'ATLAS'
          WHEN '4' THEN 'DEMETER'
          WHEN '5' THEN 'HEPHAESTUS'
          WHEN '6' THEN 'HERMES'
          WHEN '7' THEN 'MINOTAUR'
          WHEN '8' THEN 'PAN'
          WHEN '9' THEN 'PROMETHEUS'
        END
      )
      THEN RAISE(ABORT, 'God_G/God_B must match the IDs in Starting_pos')
    END;
END;
</sql><sql name="SQL 3"></sql><current_tab id="1"/></tab_sql></sqlb_project>
