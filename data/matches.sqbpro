<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="matches.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1908"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="VW_RANKING" custom_title="0" dock_id="1" table="4,10:mainVW_RANKING"/><dock_state state="000000ff00000000fd0000000100000002000005bb00000390fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005bb0000012300ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="TB_MATCHES" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="87"/><column index="3" value="87"/><column index="4" value="111"/><column index="5" value="111"/><column index="6" value="44"/><column index="7" value="39"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="TB_RATINGS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="127"/><column index="2" value="87"/><column index="3" value="135"/><column index="4" value="143"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="VW_RANKING" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="231"/><column index="2" value="47"/><column index="3" value="43"/><column index="4" value="120"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1"></sql><sql name="Edit View VW_RANKING*">DROP VIEW IF EXISTS &quot;main&quot;.&quot;VW_RANKING&quot;;
CREATE VIEW &quot;VW_RANKING&quot; AS SELECT 
    Engine || ' | ' || God AS Participant,
    ROUND(Mu, 2) AS Mu,
    ROUND(Sigma, 2) AS Sigma,
    ROUND(Mu - 3 * Sigma, 2) AS ConservativeRating
FROM TB_RATINGS
WHERE Engine = 'Fitos_1.1_Ton' OR Engine = 'Fitos_2.1_Scout' or Engine = 'Fitos_3.2_Life'
ORDER BY ConservativeRating DESC</sql><current_tab id="1"/></tab_sql></sqlb_project>
